# Copy to deploy/.env and fill in. Generate secrets with the commands shown.

# Postgres superuser (openssl rand -hex 32)
POSTGRES_PASSWORD=
# Per-app database passwords (openssl rand -hex 32)
ENDURAIN_DB_PASSWORD=
RUNNING_VIZ_DB_PASSWORD=

# Endurain
# openssl rand -hex 32
ENDURAIN_SECRET_KEY=
# openssl rand -base64 32
ENDURAIN_FERNET_KEY=
# production: https://endurain.soeenplop.dev
ENDURAIN_HOST=http://localhost:8080
# Behind a reverse proxy (production):
# ENDURAIN_BEHIND_PROXY=true
# ENDURAIN_TRUSTED_PROXIES=traefik
