# Copy to deploy/.env and fill in. Generate secrets with the commands shown.

# Postgres superuser (openssl rand -hex 32)
POSTGRES_PASSWORD=
# Per-app database passwords (openssl rand -hex 32)
ENDURAIN_DB_PASSWORD=
RUNNING_VIZ_DB_PASSWORD=

# Endurain
# openssl rand -hex 32
ENDURAIN_SECRET_KEY=
# openssl rand -base64 32
ENDURAIN_FERNET_KEY=
# production: https://endurain.soeenplop.dev
ENDURAIN_HOST=http://localhost:8080
# Behind a reverse proxy (production):
# ENDURAIN_BEHIND_PROXY=true
# ENDURAIN_TRUSTED_PROXIES=traefik

# Written by scripts/endurain-bootstrap.sh (see docs/setup.md)
# ENDURAIN_KEY_SOEREN=
# ENDURAIN_KEY_NANUQ=
# ENDURAIN_KEY_ANORI=

# HealthFit import via Dropbox (see docs/setup.md)
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_FOLDER=/Apps/HealthFitExporter
# DROPBOX_IMPORT_SINCE=2026-11-01

# "Who came along?": token for the dogs page and the Shortcut (see docs/shortcut.md); openssl rand -hex 24
# SHORTCUT_TOKEN=

# Push "Wer war dabei?" after each new run (needs SHORTCUT_TOKEN; see docs/shortcut.md).
# Secret topic: https://ntfy.sh/$(openssl rand -hex 16)
# NTFY_URL=
# PUBLIC_URL=https://running-viz-api.soeenplop.dev
